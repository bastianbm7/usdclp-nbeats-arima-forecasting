# Copiar a bot/.env y completar. bot/.env está en .gitignore: NUNCA subirlo al repo.

# simulado        -> ledger interno (no manda órdenes a ningún broker)
# oanda_practice  -> manda órdenes a la cuenta DEMO de OANDA (api-fxpractice)
MODO=simulado

# Token y cuenta de la cuenta DEMO (fxTrade Practice). Dejar vacío si aún no existe:
# en simulado el bot cae al fallback de Yahoo (con advertencia en el log).
OANDA_TOKEN=
OANDA_ACCOUNT_ID=

# Único host permitido. El bot se NIEGA a correr con api-fxtrade.oanda.com (cuenta real).
OANDA_HOST=api-fxpractice.oanda.com

# Capital inicial del ledger simulado (USD). En oanda_practice se usa el NAV real de la demo.
CAPITAL_INICIAL=10000

# Sizing fijo (sin Kelly): notional = FRACCION_NOTIONAL x equity, con tope APALANCAMIENTO_MAX x equity.
FRACCION_NOTIONAL=1.0
APALANCAMIENTO_MAX=2.0

# Estrategia e instrumentos (regla v1: cobre -> AUD).
ESTRATEGIA=cobre_aud
INSTRUMENTO=AUD_USD
INSTRUMENTO_SENAL=XCU_USD

# Minutos a esperar tras el cierre de la vela (17:00 Nueva York) antes de operar,
# para no ejecutar en el rollover, cuando el spread se abre mucho.
MINUTOS_ESPERA_CIERRE=15

# false = si la señal nueva es igual a la posición actual, se mantiene (no paga spread de nuevo).
# true  = cierra y reabre cada día (versión más "pura" de la regla, paga spread todos los días).
REABRIR_SI_MISMA_SENAL=false

# Solo MODO=simulado: auto (OANDA si hay token, si no Yahoo) | oanda | yahoo
FUENTE_DATOS_SIMULADO=auto
# Spread sintético del fallback de Yahoo (pips de AUD_USD).
SPREAD_FALLBACK_PIPS=1.4

# Rutas (relativas a bot/)
DB_PATH=data/bot.db
LOG_DIR=logs
